#!/usr/bin/env bash
unset LD_LIBRARY_PATH

# hyprland-preview-share-picker panics on headless/virtual monitors (e.g. from Morpheus)
# where physicalWidth == 0 or backend == headless. Fall back to the standard picker in that case.
if hyprctl monitors -j 2>/dev/null | grep -Eq '"physicalWidth":\s*0|"backend":\s*"headless"'; then
  exec hyprland-share-picker "$@"
fi

OUTPUT="$(hyprland-preview-share-picker "$@")"
STATUS=$?

# If the preview picker crashed (e.g. exit code >= 126 from signal abort or linker error)
if [ $STATUS -ge 126 ]; then
  exec hyprland-share-picker "$@"
fi

printf '%s\n' "$OUTPUT"
exit $STATUS
